# Copy this file to .env and fill in real values. Never commit the real .env.

# ── Core Django ──────────────────────────────────────────────────────────
# Required. Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# "True" for local development only. Must be unset/"False" in production.
DEBUG=False

# Set to "True" only once confirmed your deployment's reverse proxy/load
# balancer (a) sets X-Forwarded-Proto itself and (b) cannot be bypassed by
# clients connecting directly. Enables SSL redirect + HSTS. See settings.py.
BEHIND_TLS_PROXY=False

# ── Cache / rate limiting (accounts/rate_limit.py) ──────────────────────
# Optional for local dev (falls back to per-process LocMemCache).
# REQUIRED in any production deployment that runs more than one worker
# process/instance, or OTP/login/AI rate limits are effectively multiplied
# by the number of workers. Example: redis://localhost:6379/1
REDIS_URL=your-redis-url-here

# ── Email (accounts/email/) — Brevo transactional API ───────────────────
EMAIL_PROVIDER=brevo
BREVO_API_KEY=your-brevo-api-key-here
EMAIL_FROM=your-sender-email-here
EMAIL_FROM_NAME=your-sender-name-here
# Optional tuning — sane defaults exist in accounts/email/config.py if unset.
EMAIL_TIMEOUT_SECONDS=10
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_BASE_DELAY=1

# ── AI generation (Groq) ─────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here

# ── Razorpay billing ──────────────────────────────────────────────────────
# Billing endpoints fail safely (503, error code BILLING_NOT_CONFIGURED,
# no secrets or internals in the response) if these are absent — only
# required once real payments are enabled. Use Razorpay TEST credentials
# for local development, e.g.:
#   RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
#   RAZORPAY_KEY_SECRET=your_test_key_secret
#   RAZORPAY_WEBHOOK_SECRET=your_test_webhook_secret
# Never commit real (rzp_live_...) credentials.
RAZORPAY_KEY_ID=your-razorpay-key-id-here
RAZORPAY_KEY_SECRET=your-razorpay-key-secret-here
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret-here
