GROQ_API_KEY=your-groq-api-key
SECRET_KEY=your-django-secret-key
DEBUG=False

# Email Service (Brevo Transactional API)
# Sign up at https://www.brevo.com, verify a sender email/domain, then
# create an API key under Settings -> SMTP & API -> API Keys.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM=your-verified-sender@example.com
EMAIL_FROM_NAME=AI Generators

# Optional email tuning (sane defaults if omitted)
EMAIL_TIMEOUT_SECONDS=10
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_BASE_DELAY=1
